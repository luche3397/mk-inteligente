{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-control-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
